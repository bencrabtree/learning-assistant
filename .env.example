# Required: Claude API
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Research Interests (comma-separated)
RESEARCH_INTERESTS=multi-agent systems,reasoning,RLHF,constitutional AI,tool use

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your-app-password
RECIPIENT_EMAIL=your.email@gmail.com

# Optional: Twitter API
TWITTER_BEARER_TOKEN=
LAB_TWITTER_ACCOUNTS=@AnthropicAI,@OpenAI,@GoogleDeepMind

# Optional: Semantic Scholar
SEMANTIC_SCHOLAR_API_KEY=

# Database
DATABASE_URL=sqlite:///./data/papers.db

# TTS Settings (Audio Narration)
TTS_ENABLED=false
TTS_PROVIDER=edge
TTS_VOICE=en-US-AriaNeural
# Optional: OpenAI API key (if using OpenAI TTS)
OPENAI_API_KEY=
